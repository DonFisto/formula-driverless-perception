<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="flexirover">
    <static>false</static>

    <link name="base_link">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial>
        <mass>4.0</mass>
        <inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.03</izz></inertia>
      </inertial>

      <visual name="lower_plate_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.246 0.200 0.005</size></box></geometry>
      </visual>

      <collision name="lower_plate_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.246 0.200 0.005</size></box></geometry>
      </collision>

      <visual name="upper_plate_visual">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry><box><size>0.246 0.200 0.005</size></box></geometry>
      </visual>

      <collision name="upper_plate_collision">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry><box><size>0.246 0.200 0.005</size></box></geometry>
      </collision>

      <visual name="lidar_body_visual">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><cylinder><radius>0.030</radius><length>0.050</length></cylinder></geometry>
      </visual>

      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.15 0 0 0</pose>
        <topic>/flexirover/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </link>

    <!-- Wheels: link pose gives position, visual pose gives cylinder orientation -->

    <link name="front_left_wheel">
      <pose>0.095 0.130 0.044 0 0 0</pose>
      <inertial><mass>0.3</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.044</radius><length>0.035</length></cylinder></geometry></visual>
      <collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.044</radius><length>0.035</length></cylinder></geometry></collision>
    </link>

    <link name="front_right_wheel">
      <pose>0.095 -0.130 0.044 0 0 0</pose>
      <inertial><mass>0.3</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.044</radius><length>0.035</length></cylinder></geometry></visual>
      <collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.044</radius><length>0.035</length></cylinder></geometry></collision>
    </link>

    <link name="rear_left_wheel">
      <pose>-0.095 0.130 0.044 0 0 0</pose>
      <inertial><mass>0.3</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.044</radius><length>0.035</length></cylinder></geometry></visual>
      <collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.044</radius><length>0.035</length></cylinder></geometry></collision>
    </link>

    <link name="rear_right_wheel">
      <pose>-0.095 -0.130 0.044 0 0 0</pose>
      <inertial><mass>0.3</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
      <visual name="visual"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.044</radius><length>0.035</length></cylinder></geometry></visual>
      <collision name="collision"><pose>0 0 0 1.5708 0 0</pose><geometry><cylinder><radius>0.044</radius><length>0.035</length></cylinder></geometry></collision>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/cmd_vel</topic>
    </plugin>

  </model>
</sdf>
