<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="flexirover">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">

      <!-- Lower plate -->
      <visual name="lower_plate_visual">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>0.246 0.200 0.005</size>
          </box>
        </geometry>
      </visual>

      <collision name="lower_plate_collision">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry>
          <box>
            <size>0.246 0.200 0.005</size>
          </box>
        </geometry>
      </collision>

      <!-- Upper plate -->
      <visual name="upper_plate_visual">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry>
          <box>
            <size>0.246 0.200 0.005</size>
          </box>
        </geometry>
      </visual>

      <collision name="upper_plate_collision">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry>
          <box>
            <size>0.246 0.200 0.005</size>
          </box>
        </geometry>
      </collision>

      <!-- Four simple standoffs -->
      <visual name="front_left_post_visual">
        <pose>0.095 0.075 0.10 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </visual>

      <visual name="front_right_post_visual">
        <pose>0.095 -0.075 0.10 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </visual>

      <visual name="rear_left_post_visual">
        <pose>-0.095 0.075 0.10 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </visual>

      <visual name="rear_right_post_visual">
        <pose>-0.095 -0.075 0.10 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.006</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </visual>

      <!-- LiDAR body -->
      <visual name="lidar_body_visual">
        <pose>0 0 0.20 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.030</radius>
            <length>0.050</length>
          </cylinder>
        </geometry>
      </visual>

      <collision name="lidar_body_collision">
        <pose>0 0 0.20 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.030</radius>
            <length>0.050</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Gazebo Sim LiDAR -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.20 0 0 0</pose>
        <topic>/flexirover/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>

        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>

      <!-- Wheels as simple visuals/collisions attached to base_link -->
      <visual name="front_left_wheel_visual">
        <pose>0.095 0.130 0.044 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </visual>

      <collision name="front_left_wheel_collision">
        <pose>0.095 0.130 0.044 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="front_right_wheel_visual">
        <pose>0.095 -0.130 0.044 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </visual>

      <collision name="front_right_wheel_collision">
        <pose>0.095 -0.130 0.044 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="rear_left_wheel_visual">
        <pose>-0.095 0.130 0.044 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </visual>

      <collision name="rear_left_wheel_collision">
        <pose>-0.095 0.130 0.044 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="rear_right_wheel_visual">
        <pose>-0.095 -0.130 0.044 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </visual>

      <collision name="rear_right_wheel_collision">
        <pose>-0.095 -0.130 0.044 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </collision>

    </link>
  </model>
</sdf>
