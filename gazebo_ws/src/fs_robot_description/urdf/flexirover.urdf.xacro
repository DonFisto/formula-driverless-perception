<?xml version="1.0"?>
<robot name="flexirover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================= -->
  <!-- PARAMETERS -->
  <!-- ========================= -->

  <!-- Base plates -->
  <xacro:property name="plate_length" value="0.246"/>
  <xacro:property name="plate_width"  value="0.200"/>
  <xacro:property name="plate_thickness" value="0.005"/>

  <!-- Vertical spacing between plates -->
  <xacro:property name="deck_height" value="0.10"/>

  <!-- Wheels -->
  <xacro:property name="wheel_radius" value="0.044"/>
  <xacro:property name="wheel_width"  value="0.035"/>

  <!-- Wheel positions -->
  <xacro:property name="wheel_x" value="0.095"/>
  <xacro:property name="wheel_y" value="0.13"/>  <!-- pushed outward -->
  <xacro:property name="wheel_z" value="0.044"/>

  <!-- LiDAR -->
  <xacro:property name="lidar_height" value="0.14"/>

  <!-- ========================= -->
  <!-- BASE LINK (reference) -->
  <!-- ========================= -->

  <link name="base_link"/>

  <!-- ========================= -->
  <!-- LOWER PLATE -->
  <!-- ========================= -->

  <link name="lower_plate">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia ixx="0.02" iyy="0.02" izz="0.02"
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>

    <visual>
      <origin xyz="0 0 ${plate_thickness/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${plate_length} ${plate_width} ${plate_thickness}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 ${plate_thickness/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${plate_length} ${plate_width} ${plate_thickness}"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_lower" type="fixed">
    <parent link="base_link"/>
    <child link="lower_plate"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- UPPER PLATE -->
  <!-- ========================= -->

  <link name="upper_plate">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01"
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>

    <visual>
      <origin xyz="0 0 ${plate_thickness/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${plate_length} ${plate_width} ${plate_thickness}"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${plate_thickness/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${plate_length} ${plate_width} ${plate_thickness}"/>
      </geometry>
    </collision>
  </link>

  <joint name="lower_to_upper" type="fixed">
    <parent link="lower_plate"/>
    <child link="upper_plate"/>
    <origin xyz="0 0 ${deck_height}" rpy="0 0 0"/>
  </joint>

  <!-- ========================= -->
  <!-- WHEEL MACRO -->
  <!-- ========================= -->

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_link">
      <inertial>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <mass value="0.3"/>
        <inertia ixx="0.001" iyy="0.001" izz="0.001"
                 ixy="0.0" ixz="0.0" iyz="0.0"/>
      </inertial>

      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_gray">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="lower_plate"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Wheels -->
  <xacro:wheel name="front_left_wheel"  x="${ wheel_x}" y="${ wheel_y}"/>
  <xacro:wheel name="front_right_wheel" x="${ wheel_x}" y="${-wheel_y}"/>
  <xacro:wheel name="rear_left_wheel"   x="${-wheel_x}" y="${ wheel_y}"/>
  <xacro:wheel name="rear_right_wheel"  x="${-wheel_x}" y="${-wheel_y}"/>

  <!-- ========================= -->
  <!-- LiDAR -->
  <!-- ========================= -->

    <!-- ========================= -->
  <!-- LiDAR -->
  <!-- ========================= -->

  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" iyy="0.0001" izz="0.0001"
               ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.1 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="upper_plate"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${lidar_height}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <pose>0 0 0 0 0 0</pose>

      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>

        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>
</robot>
