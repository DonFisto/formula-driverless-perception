<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="flexirover">

    <pose>0 0 0.05 0 0 0</pose>
    <static>false</static>

    <!-- Main body link -->
    <link name="base_link">

      <inertial>
        <mass>4.0</mass>
        <inertia>
          <ixx>0.03</ixx>
          <iyy>0.03</iyy>
          <izz>0.03</izz>
        </inertia>
      </inertial>

      <!-- Lower plate -->
      <visual name="lower_plate_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.246 0.200 0.005</size>
          </box>
        </geometry>
      </visual>

      <collision name="lower_plate_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.246 0.200 0.005</size>
          </box>
        </geometry>
      </collision>

      <!-- Upper plate -->
      <visual name="upper_plate_visual">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry>
          <box>
            <size>0.246 0.200 0.005</size>
          </box>
        </geometry>
      </visual>

      <collision name="upper_plate_collision">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry>
          <box>
            <size>0.246 0.200 0.005</size>
          </box>
        </geometry>
      </collision>

      <!-- LiDAR body -->
      <visual name="lidar_visual">
        <pose>0 0 0.17 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </visual>

      <collision name="lidar_collision">
        <pose>0 0 0.17 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Working Gazebo Sim LiDAR -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.17 0 0 0</pose>
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>

        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>

          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
      </sensor>

    </link>

    <!-- Wheels as visuals/collisions for now -->

    <link name="front_left_wheel">
      <pose>0.095 0.13 0.044 1.5708 0 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <link name="front_right_wheel">
      <pose>0.095 -0.13 0.044 1.5708 0 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <link name="rear_left_wheel">
      <pose>-0.095 0.13 0.044 1.5708 0 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <link name="rear_right_wheel">
      <pose>-0.095 -0.13 0.044 1.5708 0 0</pose>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </visual>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.044</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Fixed joints to keep wheels attached for now -->

    <joint name="front_left_wheel_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_left_wheel</child>
    </joint>

    <joint name="front_right_wheel_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
    </joint>

    <joint name="rear_left_wheel_joint" type="fixed">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
    </joint>

    <joint name="rear_right_wheel_joint" type="fixed">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
    </joint>

  </model>
</sdf>

